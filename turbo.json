{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_SPOTIFY_CLIENT_ID",
        "SPOTIFY_CLIENT_SECRET",
        "NEXT_PUBLIC_SPOTIFY_REDIRECT_URI",
        "SPOTIFY_CLIENT_ID",
        "SPOTIFY_REDIRECT_URI",
        "NEXT_PUBLIC_YOUTUBE_CLIENT_ID",
        "YOUTUBE_CLIENT_SECRET",
        "APPLE_MUSIC_TEAM_ID",
        "APPLE_MUSIC_KEY_ID",
        "APPLE_MUSIC_PRIVATE_KEY",
        "REDIS_URL",
        "CRON_SECRET",
        "GOOGLE_SITE_VERIFICATION",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {},
    "type-check": {
      "dependsOn": [
        "^type-check"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!coverage/**"
      ],
      "env": [
        "REDIS_TEST_URL"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "REDIS_TEST_URL"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
